# Local development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spendwise_db?schema=public"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Production values are configured in the Vercel project dashboard, not in this file.
#
# Vercel serverless runtime: use the Supabase Transaction pooler (port 6543).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Migrations: temporarily point DATABASE_URL at the Session pooler (port 5432)
# and run: npm run prisma:migrate:deploy
#
# FRONTEND_ORIGIN="https://your-frontend.vercel.app"
# NODE_ENV="production"
